# Razorpay API Credentials (Test Mode)
# Obtain from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# Razorpay Webhook Secret
# Configured in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# LLM API Key (Google Gemini)
# Used for promise-to-pay extraction and contextual recovery message drafting
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Application Database
DATABASE_URL=sqlite:///./revenue_recovery.db
